# Auvora Wallet mobile — environment / dart-define template
#
# Copy values into CI secrets or a local untracked file.
# Flutter does NOT load this file automatically — pass each key as:
#   --dart-define=KEY=value
#
# NEVER commit real secrets.
# Full runbook: docs/API_AND_INTEGRATIONS_GUIDE.md

# ── Market data (optional; public endpoints work without keys) ──────────────
COINGECKO_API_KEY=
COINCAP_API_KEY=

# ── WalletConnect / Reown (https://cloud.reown.com) ─────────────────────────
WC_PROJECT_ID=

# ── RPC overrides (leave empty to use public defaults / Alchemy) ────────────
ALCHEMY_API_KEY=
ETH_RPC_URL=
ETH_RPC_URL_BACKUP=
POLYGON_RPC_URL=
POLYGON_RPC_URL_BACKUP=
BSC_RPC_URL=
BSC_RPC_URL_BACKUP=
SOL_RPC_URL=
SOL_RPC_URL_BACKUP=
BTC_RPC_URL=
BTC_RPC_URL_BACKUP=
TRON_RPC_URL=
TRON_RPC_URL_BACKUP=
RPC_HEALTH_PROBE_ENABLED=true

# ── Fiat on-ramp (publishable keys only; merchant account required) ─────────
MOONPAY_API_KEY=
RAMP_API_KEY=
TRANSAK_API_KEY=
ONRAMP_PARTNER_CHECKOUT_ENABLED=false

# ── Observability (hook only until sentry_flutter is linked) ────────────────
SENTRY_DSN=
SENTRY_ENABLED=false
