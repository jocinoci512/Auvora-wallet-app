{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@auvora/web",
  "ignoreCommand": "git rev-parse --verify HEAD^ >/dev/null 2>&1 && git diff --quiet HEAD^ HEAD -- . ../../packages ../../pnpm-lock.yaml ../../package.json ../../turbo.json || exit 1",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.auvorawallet.com" }],
      "destination": "https://auvorawallet.com/:path*",
      "permanent": true
    }
  ]
}
