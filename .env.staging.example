# =============================================================================
# Auvora Wallet — STAGING environment template
# Example values only. Never commit real secrets.
# Load via External Secrets / sealed secrets for real staging clusters.
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.staging.internal:4318

# Domains
APP_PUBLIC_URL=https://app.staging.auvorawallet.com
NEXT_PUBLIC_API_URL=https://api.staging.auvorawallet.com
NEXT_PUBLIC_APP_URL=https://app.staging.auvorawallet.com
NEXT_PUBLIC_ADMIN_URL=https://admin.staging.auvorawallet.com
NEXT_PUBLIC_DOCS_URL=https://docs.staging.auvorawallet.com
NEXT_PUBLIC_STATUS_URL=https://status.staging.auvorawallet.com
NEXT_PUBLIC_MARKETING_URL=https://staging.auvorawallet.com
NEXT_PUBLIC_CDN_ASSET_BASE_URL=https://cdn.staging.auvorawallet.com
CORS_ORIGINS=https://staging.auvorawallet.com,https://app.staging.auvorawallet.com,https://admin.staging.auvorawallet.com,https://docs.staging.auvorawallet.com,https://status.staging.auvorawallet.com
COOKIE_SECURE=true
COOKIE_DOMAIN=.staging.auvorawallet.com

# Data plane
DATABASE_URL=postgresql://auvora:<secret>@postgres.staging.internal:5432/auvora_wallet?schema=public&connection_limit=20&pool_timeout=10
REDIS_URL=redis://:<secret>@redis.staging.internal:6379

JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-64>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-64>
CSRF_SECRET=<generate-with-openssl-rand-base64-32>
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

CDN_ASSET_BASE_URL=https://cdn.staging.auvorawallet.com
OBJECT_STORAGE_BUCKET=auvora-wallet-staging-assets
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=<secret>
OBJECT_STORAGE_SECRET_KEY=<secret>

# Blockchain — live Alchemy (never commit real keys)
BLOCKCHAIN_SIMULATOR_ENABLED=false
BLOCKCHAIN_PRIMARY_PROVIDER=alchemy
ALCHEMY_API_KEY=<secret>
ALCHEMY_RPC_TIMEOUT_MS=12000
# Optional per-chain overrides:
# ALCHEMY_ETHEREUM_RPC_URL=
# ALCHEMY_BSC_RPC_URL=
# ALCHEMY_SOLANA_RPC_URL=
# ALCHEMY_TRON_RPC_URL=
# ALCHEMY_BITCOIN_RPC_URL=

# Workers (staging mirrors production: enabled)
WALLET_WORKERS_ENABLED=true
MARKET_DATA_WORKERS_ENABLED=true
SWAP_WORKERS_ENABLED=true
NFT_WORKERS_ENABLED=true
STAKING_WORKERS_ENABLED=true
BRIDGE_WORKERS_ENABLED=true
CONNECTIONS_WORKERS_ENABLED=true
NOTIFICATIONS_QUEUE_WORKER_ENABLED=true
NOTIFICATIONS_WEBHOOK_WORKER_ENABLED=true

# Prefer live providers when keys exist; otherwise keep simulators for non-chain domains
PAYMENTS_SIMULATOR_ENABLED=false
COMPLIANCE_SIMULATOR_ENABLED=false
CUSTODY_SIMULATOR_ENABLED=false
NOTIFICATIONS_SIMULATOR_ENABLED=false
MARKET_DATA_SIMULATOR_ENABLED=false
SWAP_SIMULATOR_ENABLED=true
NFT_SIMULATOR_ENABLED=true
STAKING_SIMULATOR_ENABLED=true
BRIDGE_SIMULATOR_ENABLED=true
CONNECTIONS_SIMULATOR_ENABLED=true
AI_SIMULATOR_ENABLED=true

# Mail (staging)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.staging.internal
SMTP_PORT=587
SMTP_USER=<secret>
SMTP_PASS=<secret>
SMTP_FROM=noreply@staging.auvorawallet.com

# Edge
GATEWAY_RATE_LIMIT_MAX=400
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_MS=30000

# In-cluster URLs (Helm ConfigMap usually supplies these)
AUTH_SERVICE_URL=http://auth:4001
WALLET_SERVICE_URL=http://wallet:3002
BLOCKCHAIN_SERVICE_URL=http://blockchain:3003
PAYMENTS_SERVICE_URL=http://payments:3004
COMPLIANCE_SERVICE_URL=http://compliance:3005
NOTIFICATIONS_SERVICE_URL=http://notifications:3006
ANALYTICS_SERVICE_URL=http://analytics:3007
AI_SERVICE_URL=http://ai:3008
CUSTODY_SERVICE_URL=http://custody:3009
OBSERVABILITY_SERVICE_URL=http://observability:3010
MARKET_DATA_SERVICE_URL=http://market-data:3012
SWAP_SERVICE_URL=http://swap:3013
NFT_SERVICE_URL=http://nft:3014
STAKING_SERVICE_URL=http://staking:3015
CONNECTIONS_SERVICE_URL=http://connections:3016
BRIDGE_SERVICE_URL=http://bridge:3017
