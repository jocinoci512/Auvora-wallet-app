environment  = "staging"
aws_region   = "us-east-1"
project_name = "auvora-wallet"
vpc_cidr     = "10.23.0.0/16"

modules = {
  networking   = { enabled = false }
  postgres     = { enabled = false, instance_size = "medium", backup_retention_days = 14 }
  redis        = { enabled = false, node_type = "medium" }
  storage      = { enabled = false }
  secrets      = { enabled = false, backend = "aws_sm" }
  iam          = { enabled = false }
  monitoring   = { enabled = false, log_retention_days = 30 }
  kubernetes   = { enabled = false, node_count_min = 2, node_count_max = 6 }
  dns          = { enabled = false, subdomain = "staging" }
  loadbalancer = { enabled = false }
}
