# syntax=docker/dockerfile:1
#
# TEMPORARY Railway one-shot: cloud synthetic vault-recovery acceptance.
# Private networking only. No public HTTP. Never restarts.

FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config ./packages/config
COPY packages/vault-crypto ./packages/vault-crypto
COPY scripts/qa/cloud-acceptance-recovery.mjs ./scripts/qa/cloud-acceptance-recovery.mjs
COPY scripts/qa/cloud-acceptance-package.json ./scripts/qa/cloud-acceptance-package.json

RUN pnpm install --frozen-lockfile --filter @auvora/vault-crypto... \
  && pnpm --filter @auvora/vault-crypto build

WORKDIR /app/harness
# Harness loads vault-crypto from packages/vault-crypto/dist (no npm workspace: protocol).
RUN mkdir -p packages/vault-crypto/dist scripts/qa \
  && cp -R /app/packages/vault-crypto/dist/. packages/vault-crypto/dist/ \
  && cp /app/scripts/qa/cloud-acceptance-recovery.mjs scripts/qa/ \
  && cp /app/scripts/qa/cloud-acceptance-package.json ./package.json \
  && npm install --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system auvora \
  && useradd --system --gid auvora --create-home auvora
COPY --from=build --chown=auvora:auvora /app/harness ./
USER auvora
CMD ["node", "scripts/qa/cloud-acceptance-recovery.mjs"]
