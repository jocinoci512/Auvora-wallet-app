# syntax=docker/dockerfile:1
#
# TEMPORARY Railway one-shot service: Prisma migrate deploy + status only.
# Does NOT run an HTTP server. Does NOT reset / push / seed.
#
# Build (from repo root):
#   docker build -f infrastructure/docker/Dockerfile.migrate \
#     -t auvora/db-migrate:latest .
#
# Railway (temporary `db-migrate` service):
#   - Config as Code = /railway.migrate.toml  (required — not root railway.toml)
#   - Root Directory = blank / "/"
#   - Variables: DATABASE_URL only (reference Postgres plugin)
#   - Custom start command: empty (use image CMD)
#   - No PORT / no public networking / tear down after success
#
# Why NOT --ignore-workspace --lockfile-dir=.. (previous approach):
#   That layout broke Prisma 6.5.0 @prisma/engines postinstall with ENOENT under
#   /app/node_modules/.pnpm/@prisma+engines@.../node_modules/@prisma/node_modules
#   because the lockfile root and package root disagreed.
#
# Why NOT full monorepo pnpm install:
#   Root package.json pulls redis-memory-server / embedded-postgres (local-only);
#   their postinstall downloads Redis and fails on containers.
#
# Correct strategy (C — dedicated package install):
#   Install ONLY database/package.json dependencies inside /app/database with a
#   normal pnpm layout (exact prisma@6.5.0 / @prisma/client@6.5.0 / argon2 pins).
#   No workspace root, no lockfile-dir escape, no redis-memory-server.
#
# Runtime (exit 0 only if both succeed):
#   pnpm exec prisma migrate deploy
#   pnpm exec prisma migrate status

# Debian slim is safer for Prisma engine binaries than Alpine for this one-shot.
FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV CI=true
# Do NOT set NODE_ENV=production — prisma is a database-schema devDependency.
RUN corepack enable \
  && corepack prepare pnpm@9.15.9 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
# argon2 needs a native toolchain; keep it out of the final runtime layer tools if possible
# (we run generate in this stage too, so toolchain stays for the single-stage migrate image).
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
# Copy ONLY the database package — never root package.json (redis-memory-server).
COPY database/package.json ./database/
COPY database/prisma ./database/prisma/
WORKDIR /app/database
# Structurally correct pnpm install for this package (creates package-local lockfile).
# Exact versions for prisma / @prisma/client / argon2 are pinned in package.json.
RUN pnpm install \
  && test ! -e ./node_modules/redis-memory-server \
  && test ! -e /app/node_modules/redis-memory-server \
  && test -f ./node_modules/prisma/package.json \
  && test -d ./node_modules/.pnpm/@prisma+engines@6.5.0 \
  && pnpm exec prisma --version

FROM deps AS migrate
WORKDIR /app/database
RUN test -f prisma/schema.prisma \
  && test -f prisma/migrations/migration_lock.toml \
  && test -d prisma/migrations \
  && pnpm exec prisma generate \
  && test -f generated/client/index.js

RUN groupadd --system auvora \
  && useradd --system --gid auvora --create-home auvora \
  && chown -R auvora:auvora /app
USER auvora

# DATABASE_URL must be injected at runtime (Railway Postgres reference). No other secrets required.
CMD ["sh", "-ec", "pnpm exec prisma migrate deploy && pnpm exec prisma migrate status"]
