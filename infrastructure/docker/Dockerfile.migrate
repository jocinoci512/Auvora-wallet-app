# syntax=docker/dockerfile:1
#
# TEMPORARY Railway one-shot service: Prisma migrate deploy + status only.
# Does NOT run an HTTP server. Does NOT reset / push / seed.
#
# Build (from repo root):
#   docker build -f infrastructure/docker/Dockerfile.migrate \
#     -t auvora/db-migrate:latest .
#
# Railway (temporary `db-migrate` service):
#   - Root Directory = blank / "/"
#   - Dockerfile path = infrastructure/docker/Dockerfile.migrate
#   - Variables: DATABASE_URL only (reference Postgres plugin)
#   - Custom start command: empty (use image CMD)
#   - No PORT / no public networking / tear down after success
#
# Dependency isolation:
#   Root package.json pulls redis-memory-server (and embedded-postgres) for local
#   scripts only — their postinstall downloads Redis and breaks Alpine builds
#   (pkg-config/bash). A full-workspace `pnpm install` never reaches migrate.
#   This image installs ONLY @auvora/database-schema from the lockfile via
#   `pnpm install --ignore-workspace --frozen-lockfile --lockfile-dir=..`
#   inside database/ (no apps/services stubs, no root tooling).
#
# Runtime (exit 0 only if both succeed):
#   pnpm exec prisma migrate deploy
#   pnpm exec prisma migrate status

FROM node:22-alpine AS base
WORKDIR /app
# Skip husky prepare; align with packageManager/engines (pnpm@9.15.9, node>=22).
# Do NOT set NODE_ENV=production here — prisma is a database-schema devDependency.
ENV CI=true
RUN corepack enable \
  && corepack prepare pnpm@9.15.9 --activate \
  && apk add --no-cache libc6-compat openssl

FROM base AS deps
# argon2 (database-schema dependency) needs a native toolchain on Alpine.
RUN apk add --no-cache python3 make g++
COPY pnpm-lock.yaml package.json ./
COPY database ./database
# Lockfile was resolved with root `pnpm.overrides`. --ignore-workspace reads
# database/package.json only — inject overrides so --frozen-lockfile matches.
RUN node -e "const fs=require('fs'); const root=JSON.parse(fs.readFileSync('package.json','utf8')); const db=JSON.parse(fs.readFileSync('database/package.json','utf8')); db.pnpm={...(db.pnpm||{}), overrides: root.pnpm.overrides}; fs.writeFileSync('database/package.json', JSON.stringify(db, null, 2) + '\n');"
WORKDIR /app/database
RUN pnpm install --ignore-workspace --frozen-lockfile --lockfile-dir=.. \
  && test ! -e /app/node_modules/redis-memory-server \
  && test ! -e ./node_modules/redis-memory-server \
  && test -f ./node_modules/prisma/package.json

FROM deps AS migrate
WORKDIR /app/database
RUN test -f prisma/schema.prisma \
  && test -f prisma/migrations/migration_lock.toml \
  && test -d prisma/migrations \
  && pnpm exec prisma generate

RUN addgroup -S auvora && adduser -S auvora -G auvora \
  && chown -R auvora:auvora /app
USER auvora

# DATABASE_URL must be injected at runtime (Railway Postgres reference). No other secrets required.
# Fail closed: deploy then status; non-zero from either fails the container.
CMD ["sh", "-ec", "pnpm exec prisma migrate deploy && pnpm exec prisma migrate status"]
