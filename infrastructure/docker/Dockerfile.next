# syntax=docker/dockerfile:1

# Production Next.js app image (multi-stage, non-root, standalone output).
# Build: docker build -f infrastructure/docker/Dockerfile.next --build-arg APP=web --build-arg PORT=3000 -t auvora/web:latest .

FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
ARG APP=web
COPY apps/${APP}/package.json ./apps/${APP}/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG APP=web
COPY apps/${APP} ./apps/${APP}
ENV NEXT_TELEMETRY_DISABLED=1
ENV DOCKER_BUILD=true
ENV NODE_ENV=production
RUN pnpm turbo run build --filter=@auvora/${APP}

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG APP=web
ARG PORT=3000
ENV APP=${APP}
ENV PORT=${PORT}
ENV HOSTNAME=0.0.0.0
RUN addgroup -S auvora && adduser -S auvora -G auvora \
  && apk add --no-cache wget
COPY --from=build /app/apps/${APP}/.next/standalone ./
COPY --from=build /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /app/apps/${APP}/public ./apps/${APP}/public
USER auvora
EXPOSE ${PORT}
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/" || exit 1
CMD node apps/${APP}/server.js
