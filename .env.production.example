# =============================================================================
# Auvora Wallet â€” PRODUCTION environment template
# Example values only. Never commit real secrets. Never use local placeholders.
# Load via Vercel / secrets manager / External Secrets â†’ Helm secretRef.
# See also: .env.example Â· DEPLOYMENT.md
# =============================================================================

NODE_ENV=production
LOG_LEVEL=warn
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.prod.internal:4318

# Public domains (must match DNS + ingress / Vercel)
APP_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_DOCS_URL=https://docs.example.com
NEXT_PUBLIC_STATUS_URL=https://status.example.com
NEXT_PUBLIC_MARKETING_URL=https://example.com
NEXT_PUBLIC_CDN_ASSET_BASE_URL=https://cdn.example.com
NEXT_PUBLIC_APP_NAME=Auvora Wallet
CORS_ORIGINS=https://example.com,https://www.example.com,https://app.example.com,https://admin.example.com,https://docs.example.com,https://status.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=.example.com

# Managed Postgres + Redis (pooled)
DATABASE_URL=postgresql://auvora:<secret>@postgres.prod.internal:5432/auvora_wallet?schema=public&connection_limit=40&pool_timeout=10
REDIS_URL=redis://:<secret>@redis.prod.internal:6379

JWT_ACCESS_SECRET=<rotate-via-secrets-manager>
JWT_REFRESH_SECRET=<rotate-via-secrets-manager>
CSRF_SECRET=<rotate-via-secrets-manager>
INTERNAL_API_KEY=<rotate-via-secrets-manager>

CDN_ASSET_BASE_URL=https://cdn.example.com
OBJECT_STORAGE_BUCKET=auvora-wallet-prod-assets
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=<secret>
OBJECT_STORAGE_SECRET_KEY=<secret>

# Blockchain
BLOCKCHAIN_SIMULATOR_ENABLED=false
BLOCKCHAIN_PRIMARY_PROVIDER=alchemy
ALCHEMY_API_KEY=<secret>
ALCHEMY_RPC_TIMEOUT_MS=12000

# All provider simulators MUST be false in production
PAYMENTS_SIMULATOR_ENABLED=false
COMPLIANCE_SIMULATOR_ENABLED=false
CUSTODY_SIMULATOR_ENABLED=false
NOTIFICATIONS_SIMULATOR_ENABLED=false
MARKET_DATA_SIMULATOR_ENABLED=false
SWAP_SIMULATOR_ENABLED=false
NFT_SIMULATOR_ENABLED=false
STAKING_SIMULATOR_ENABLED=false
BRIDGE_SIMULATOR_ENABLED=false
CONNECTIONS_SIMULATOR_ENABLED=false
AI_SIMULATOR_ENABLED=false

# Workers
WALLET_WORKERS_ENABLED=true
MARKET_DATA_WORKERS_ENABLED=true
SWAP_WORKERS_ENABLED=true
NFT_WORKERS_ENABLED=true
STAKING_WORKERS_ENABLED=true
BRIDGE_WORKERS_ENABLED=true
CONNECTIONS_WORKERS_ENABLED=true
NOTIFICATIONS_QUEUE_WORKER_ENABLED=true
NOTIFICATIONS_WEBHOOK_WORKER_ENABLED=true

# Mail
MAIL_DRIVER=smtp
SMTP_HOST=smtp.prod.internal
SMTP_PORT=587
SMTP_USER=<secret>
SMTP_PASS=<secret>
SMTP_FROM=noreply@example.com

# In-cluster service mesh URLs (Kubernetes DNS). For Docker Compose / Railway,
# replace with public or private service hostnames.
AUTH_SERVICE_URL=http://auth:4001
WALLET_SERVICE_URL=http://wallet:3002
BLOCKCHAIN_SERVICE_URL=http://blockchain:3003
PAYMENTS_SERVICE_URL=http://payments:3004
COMPLIANCE_SERVICE_URL=http://compliance:3005
NOTIFICATIONS_SERVICE_URL=http://notifications:3006
ANALYTICS_SERVICE_URL=http://analytics:3007
AI_SERVICE_URL=http://ai:3008
CUSTODY_SERVICE_URL=http://custody:3009
OBSERVABILITY_SERVICE_URL=http://observability:3010
MARKET_DATA_SERVICE_URL=http://market-data:3012
SWAP_SERVICE_URL=http://swap:3013
NFT_SERVICE_URL=http://nft:3014
STAKING_SERVICE_URL=http://staking:3015
CONNECTIONS_SERVICE_URL=http://connections:3016
BRIDGE_SERVICE_URL=http://bridge:3017

GATEWAY_RATE_LIMIT_MAX=400
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_MS=30000
