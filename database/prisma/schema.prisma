  FIAT_WITHDRAWAL
  CRYPTO_DEPOSIT
  CRYPTO_WITHDRAWAL
  INTERNAL_TRANSFER
  WALLET_TRANSFER
  MERCHANT_PAYMENT
  SCHEDULED_PAYMENT
  RECURRING_PAYMENT
  PAYMENT_REQUEST
  REFUND
  REVERSAL
  SETTLEMENT
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PROCESSING
  SETTLED
  COMPLETED
  CANCELLED
  FAILED
  EXPIRED
  REFUNDED
  REVERSED
  DISPUTED
  CHARGEBACK
}

enum PaymentMethodType {
  BANK_ACCOUNT
  CARD
  WALLET
  CRYPTO_ADDRESS
  MERCHANT
  OTHER
}

enum SettlementMode {
  INSTANT
  DAILY
  SCHEDULED
  MANUAL
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  MISMATCH
  EXCEPTION
  MANUAL_REVIEW
  RESOLVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

enum ChargebackStatus {
  OPEN
  ACCEPTED
  DEFENDED
  WON
  LOST
  CLOSED
}

enum LimitWindow {
  PER_TRANSACTION
  DAILY
  WEEKLY
  MONTHLY
}

model PaymentProviderRecord {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  providerType String   @map("provider_type")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  priority     Int      @default(100)
  capabilities Json?
  endpointUrl  String?  @map("endpoint_url")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  payments Payment[]
  health   PaymentProviderHealthSnapshot[]

  @@index([isEnabled, priority])
  @@map("payment_providers")
}

model PaymentMethod {
  id          String            @id @default(uuid()) @db.Uuid
  ownerUserId String            @map("owner_user_id") @db.Uuid
  type        PaymentMethodType
  label       String?
  isDefault   Boolean           @default(false) @map("is_default")
  isActive    Boolean           @default(true) @map("is_active")
  last4       String?
  country     String?
  currency    String?
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  archivedAt  DateTime?         @map("archived_at")

  payments Payment[]

  @@index([ownerUserId, isActive])
  @@map("payment_methods")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  reference           String        @unique
  type                PaymentType
  status              PaymentStatus @default(CREATED)
  ownerUserId         String        @map("owner_user_id") @db.Uuid
  amount              Decimal       @db.Decimal(36, 18)
  feeAmount           Decimal       @default(0) @map("fee_amount") @db.Decimal(36, 18)
  currency            String
  assetCode           String?       @map("asset_code")
  fromWalletId        String?       @map("from_wallet_id") @db.Uuid
  toWalletId          String?       @map("to_wallet_id") @db.Uuid
  paymentMethodId     String?       @map("payment_method_id") @db.Uuid
  providerId          String?       @map("provider_id") @db.Uuid
  providerRef         String?       @map("provider_ref")
  idempotencyKey      String?       @unique @map("idempotency_key")
  correlationId       String?       @map("correlation_id")
  walletTransactionId String?       @map("wallet_transaction_id") @db.Uuid
  chainTxId           String?       @map("chain_tx_id") @db.Uuid
  country             String?
  accountTier         String?       @map("account_tier")
  riskProfile         String?       @map("risk_profile")
  riskFlags           String[]      @default([]) @map("risk_flags")
  description         String?
  failureReason       String?       @map("failure_reason")
  scheduledAt         DateTime?     @map("scheduled_at")
  authorizedAt        DateTime?     @map("authorized_at")
  settledAt           DateTime?     @map("settled_at")
  completedAt         DateTime?     @map("completed_at")
  cancelledAt         DateTime?     @map("cancelled_at")
  expiresAt           DateTime?     @map("expires_at")
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  paymentMethod   PaymentMethod?         @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  provider        PaymentProviderRecord? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  settlements     Settlement[]
  refunds         Refund[]
  disputes        Dispute[]
  chargebacks     Chargeback[]
  reconciliations ReconciliationRecord[]

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([providerRef])
  @@index([correlationId])
  @@index([type, status])
  @@map("payments")
}

model SettlementBatch {
  id            String           @id @default(uuid()) @db.Uuid
  reference     String           @unique
  mode          SettlementMode
  status        SettlementStatus @default(PENDING)
  currency      String
  totalAmount   Decimal          @default(0) @map("total_amount") @db.Decimal(36, 18)
  paymentCount  Int              @default(0) @map("payment_count")
  scheduledAt   DateTime?        @map("scheduled_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  failedAt      DateTime?        @map("failed_at")
  failureReason String?          @map("failure_reason")
  report        Json?
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  settlements Settlement[]

  @@index([status, scheduledAt])
  @@index([mode, createdAt])
  @@map("settlement_batches")
}

model Settlement {
  id            String           @id @default(uuid()) @db.Uuid
  batchId       String?          @map("batch_id") @db.Uuid
  paymentId     String           @map("payment_id") @db.Uuid
  mode          SettlementMode
  status        SettlementStatus @default(PENDING)
  amount        Decimal          @db.Decimal(36, 18)
  currency      String
  reference     String           @unique
  auditTrail    Json?            @map("audit_trail")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  failedAt      DateTime?        @map("failed_at")
  failureReason String?          @map("failure_reason")
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  batch   SettlementBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payment Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([paymentId])
  @@index([status, createdAt])
  @@map("settlements")
}

model PaymentLimit {
  id          String      @id @default(uuid()) @db.Uuid
  window      LimitWindow
  amount      Decimal     @db.Decimal(36, 18)
  currency    String?
  assetCode   String?     @map("asset_code")
  ownerUserId String?     @map("owner_user_id") @db.Uuid
  accountTier String?     @map("account_tier")
  country     String?
  riskProfile String?     @map("risk_profile")
  isEnabled   Boolean     @default(true) @map("is_enabled")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([ownerUserId, window, isEnabled])
  @@index([accountTier, window])
  @@index([country, window])
  @@index([riskProfile, window])
  @@map("payment_limits")
}

model ReconciliationRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  paymentId            String?              @map("payment_id") @db.Uuid
  settlementId         String?              @map("settlement_id") @db.Uuid
  status               ReconciliationStatus @default(PENDING)
  source               String
  expectedAmount       Decimal?             @map("expected_amount") @db.Decimal(36, 18)
  actualAmount         Decimal?             @map("actual_amount") @db.Decimal(36, 18)
  currency             String?
  mismatchReason       String?              @map("mismatch_reason")
  requiresManualReview Boolean              @default(false) @map("requires_manual_review")
  resolvedAt           DateTime?            @map("resolved_at")
  resolvedBy           String?              @map("resolved_by") @db.Uuid
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([paymentId])
  @@index([requiresManualReview, status])
  @@map("reconciliation_records")
}

model Refund {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @map("payment_id") @db.Uuid
  amount      Decimal       @db.Decimal(36, 18)
  currency    String
  status      PaymentStatus @default(CREATED)
  reason      String?
  providerRef String?       @map("provider_ref")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  completedAt DateTime?     @map("completed_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

model Dispute {
  id        String        @id @default(uuid()) @db.Uuid
  paymentId String        @map("payment_id") @db.Uuid
  status    DisputeStatus @default(OPEN)
  reason    String?
  amount    Decimal?      @db.Decimal(36, 18)
  currency  String?
  metadata  Json?
  openedAt  DateTime      @default(now()) @map("opened_at")
  closedAt  DateTime?     @map("closed_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, openedAt])
  @@map("disputes")
}

model Chargeback {
  id          String           @id @default(uuid()) @db.Uuid
  paymentId   String           @map("payment_id") @db.Uuid
  status      ChargebackStatus @default(OPEN)
  amount      Decimal          @db.Decimal(36, 18)
  currency    String
  reason      String?
  providerRef String?          @map("provider_ref")
  metadata    Json?
  openedAt    DateTime         @default(now()) @map("opened_at")
  closedAt    DateTime?        @map("closed_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, openedAt])
  @@map("chargebacks")
}

model PaymentEventLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @map("event_type")
  aggregateId   String?  @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([aggregateId, createdAt])
  @@map("payment_event_logs")
}

model PaymentProviderHealthSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String?  @map("provider_id") @db.Uuid
  providerCode String   @map("provider_code")
  status       String
  latencyMs    Int?     @map("latency_ms")
  errorMessage String?  @map("error_message")
  checkedAt    DateTime @default(now()) @map("checked_at")

  provider PaymentProviderRecord? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([providerCode, checkedAt])
  @@index([providerId, checkedAt])
  @@map("payment_provider_health_snapshots")
}

