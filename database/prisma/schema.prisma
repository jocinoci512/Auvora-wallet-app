  /// watch_only | ownership_verified — never stores private keys
  linkMode             String             @default("watch_only") @map("link_mode")
  ownershipVerifiedAt  DateTime?          @map("ownership_verified_at")
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@unique([userId, network, address])
  @@index([userId, status])
  @@index([userId, ownershipVerifiedAt])
  @@map("watch_addresses")
}

/// Public-address ownership challenge (nonce → wallet sign → verify). Never stores seeds/keys.
model AddressOwnershipChallenge {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  network    ChainNetwork
  address    String
  nonce      String       @unique
  message    String
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([userId, address])
  @@index([expiresAt])
  @@map("address_ownership_challenges")
}

model ExternalWalletConnection {
  id             String                         @id @default(uuid()) @db.Uuid
  userId         String                         @map("user_id") @db.Uuid
  kind           ExternalWalletKind
  status         ExternalWalletConnectionStatus @default(PENDING)
  providerCode   String                         @map("provider_code")
  label          String?
  externalRef    String?                        @map("external_ref")
  canSign        Boolean                        @default(false) @map("can_sign")
  metadata       Json?
  connectedAt    DateTime?                      @map("connected_at")
  disconnectedAt DateTime?                      @map("disconnected_at")
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")

  @@index([userId, kind, status])
  @@index([providerCode])
  @@index([externalRef])
  @@map("external_wallet_connections")
}

model ExternalSigningRequest {
  id                   String                       @id @default(uuid()) @db.Uuid
  userId               String                       @map("user_id") @db.Uuid
  kind                 ExternalWalletKind
  connectionRef        String                       @map("connection_ref")
  network              ChainNetwork
  payloadType          String                       @map("payload_type")
  payloadHash          String                       @map("payload_hash")
  preview              String
  feeEstimate          String?                      @map("fee_estimate")
  providerRequestId    String?                      @map("provider_request_id")
  status               ExternalSigningRequestStatus @default(PENDING_CONFIRMATION)
  requiresConfirmation Boolean                      @default(true) @map("requires_confirmation")
  signature            String?
  txHash               String?                      @map("tx_hash")
  errorMessage         String?                      @map("error_message")
  confirmedAt          DateTime?                    @map("confirmed_at")
  completedAt          DateTime?                    @map("completed_at")
  metadata             Json?
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([connectionRef])
  @@map("external_signing_requests")
}

model ConnectionProviderHealth {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  isEnabled     Boolean   @default(true) @map("is_enabled")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  lastLatencyMs Int?      @map("last_latency_ms")
  failureCount  Int       @default(0) @map("failure_count")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("connection_provider_health")
}

model ConnectionSyncJob {
  id           String                  @id @default(uuid()) @db.Uuid
  jobType      String                  @map("job_type")
  status       ConnectionSyncJobStatus @default(PENDING)
  durationMs   Int?                    @map("duration_ms")
  errorMessage String?                 @map("error_message")
  payload      Json?
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("connection_sync_jobs")
}

model ConnectionRetryJob {
  id           String                   @id @default(uuid()) @db.Uuid
  operationId  String?                  @map("operation_id") @db.Uuid
  jobType      String                   @map("job_type")
  status       ConnectionRetryJobStatus @default(PENDING)
  payload      Json?
  errorMessage String?                  @map("error_message")
  processedAt  DateTime?                @map("processed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("connection_retry_jobs")
}

// ---------------------------------------------------------------------------
// Phase 24 — Cross-Chain Bridge & Asset Transfer
// ---------------------------------------------------------------------------

enum BridgeTransferStatus {
  PENDING_CONFIRMATION
  SUBMITTED
  BRIDGING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum BridgeSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BridgeRetryJobStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

model BridgeQuote {
  id                         String       @id @default(uuid()) @db.Uuid
  userId                     String       @map("user_id") @db.Uuid
  providerCode               String       @map("provider_code")
  providerQuoteId            String       @map("provider_quote_id")
  sourceNetwork              ChainNetwork @map("source_network")
  destinationNetwork         ChainNetwork @map("destination_network")
  assetSymbol                String       @map("asset_symbol")
  amountIn                   String       @map("amount_in")
  amountOut                  String       @map("amount_out")
  minAmountOut               String       @map("min_amount_out")
  feeAmount                  String       @map("fee_amount")
  feeAsset                   String       @map("fee_asset")
  estimatedFeeNative         String       @map("estimated_fee_native")
  estimatedCompletionSeconds Int          @map("estimated_completion_seconds")
  routeSummary               String       @map("route_summary")
  routeJson                  Json         @map("route_json")
  replayNonce                String       @unique @map("replay_nonce")
  expiresAt                  DateTime     @map("expires_at")
  metadata                   Json?
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  transfers BridgeTransfer[]

  @@index([userId, createdAt])
  @@map("bridge_quotes")
}

model BridgeTransfer {
  id                         String               @id @default(uuid()) @db.Uuid
  userId                     String               @map("user_id") @db.Uuid
  quoteId                    String?              @map("quote_id") @db.Uuid
  providerCode               String               @map("provider_code")
  providerQuoteId            String               @map("provider_quote_id")
  providerRef                String?              @map("provider_ref")
  status                     BridgeTransferStatus @default(PENDING_CONFIRMATION)
  sourceNetwork              ChainNetwork         @map("source_network")
  destinationNetwork         ChainNetwork         @map("destination_network")
  assetSymbol                String               @map("asset_symbol")
  amountIn                   String               @map("amount_in")
  amountOutExpected          String               @map("amount_out_expected")
  amountOutActual            String?              @map("amount_out_actual")
  feeAmount                  String               @map("fee_amount")
  feeAsset                   String               @map("fee_asset")
  estimatedCompletionSeconds Int                  @map("estimated_completion_seconds")
  routeSummary               String               @map("route_summary")
  preparedTx                 Json?                @map("prepared_tx")
  requiresConfirmation       Boolean              @default(true) @map("requires_confirmation")
  replayNonce                String               @map("replay_nonce")
  sourceAddress              String?              @map("source_address")
  destinationAddress         String?              @map("destination_address")
  sourceTxHash               String?              @map("source_tx_hash")
  destinationTxHash          String?              @map("destination_tx_hash")
  errorMessage               String?              @map("error_message")
  confirmedAt                DateTime?            @map("confirmed_at")
  executedAt                 DateTime?            @map("executed_at")
  completedAt                DateTime?            @map("completed_at")
  metadata                   Json?
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  quote   BridgeQuote?   @relation(fields: [quoteId], references: [id])
  receipt BridgeReceipt?

  @@index([userId, status])
  @@index([providerRef])
  @@map("bridge_transfers")
}

model BridgeReceipt {
  id                 String       @id @default(uuid()) @db.Uuid
  transferId         String       @unique @map("transfer_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  providerCode       String       @map("provider_code")
  sourceNetwork      ChainNetwork @map("source_network")
  destinationNetwork ChainNetwork @map("destination_network")
  assetSymbol        String       @map("asset_symbol")
  amountIn           String       @map("amount_in")
  amountOut          String       @map("amount_out")
  sourceTxHash       String?      @map("source_tx_hash")
  destinationTxHash  String?      @map("destination_tx_hash")
  status             String
  payloadEncrypted   String?      @map("payload_encrypted")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  transfer BridgeTransfer @relation(fields: [transferId], references: [id])

  @@index([userId, createdAt])
  @@map("bridge_receipts")
}

model BridgeRouteCatalog {
  id                         String       @id @default(uuid()) @db.Uuid
  providerCode               String       @map("provider_code")
  routeId                    String       @map("route_id")
  sourceNetwork              ChainNetwork @map("source_network")
  destinationNetwork         ChainNetwork @map("destination_network")
  assetSymbol                String       @map("asset_symbol")
  supported                  Boolean      @default(true)
  reason                     String?
  estimatedFeeNative         String       @map("estimated_fee_native")
  estimatedCompletionSeconds Int          @map("estimated_completion_seconds")
  hops                       Json?
  lastSyncedAt               DateTime?    @map("last_synced_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  @@unique([providerCode, routeId])
  @@index([sourceNetwork, destinationNetwork])
  @@map("bridge_route_catalog")
}

model BridgeProviderHealth {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  isEnabled     Boolean   @default(true) @map("is_enabled")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  lastLatencyMs Int?      @map("last_latency_ms")
  failureCount  Int       @default(0) @map("failure_count")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("bridge_provider_health")
}

model BridgeSyncJob {
  id           String              @id @default(uuid()) @db.Uuid
  jobType      String              @map("job_type")
  status       BridgeSyncJobStatus @default(PENDING)
  durationMs   Int?                @map("duration_ms")
  errorMessage String?             @map("error_message")
  payload      Json?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("bridge_sync_jobs")
}

model BridgeRetryJob {
  id           String               @id @default(uuid()) @db.Uuid
  transferId   String?              @map("transfer_id") @db.Uuid
  jobType      String               @map("job_type")
  status       BridgeRetryJobStatus @default(PENDING)
  payload      Json?
  errorMessage String?              @map("error_message")
  processedAt  DateTime?            @map("processed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("bridge_retry_jobs")
}

// ---------------------------------------------------------------------------
// Phase 26 — Enterprise Web3 Connectivity & dApp Platform
// ---------------------------------------------------------------------------

enum DappConnectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum TrustedDappStatus {
  TRUSTED
  REVOKED
}

enum DappPermissionCode {
  VIEW_ADDRESSES
  VIEW_BALANCES
  REQUEST_SIGNATURES
  REQUEST_TRANSACTIONS
  NETWORK_SWITCH
  SESSION_MANAGE
}

model TrustedDapp {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  origin             String
  name               String
  iconUrl            String?           @map("icon_url")
  networks           Json
  defaultPermissions Json              @map("default_permissions")
  status             TrustedDappStatus @default(TRUSTED)
  trustedAt          DateTime          @default(now()) @map("trusted_at")
  revokedAt          DateTime?         @map("revoked_at")
  lastConnectedAt    DateTime?         @map("last_connected_at")
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([userId, origin])
  @@index([userId, status])
  @@map("trusted_dapps")
}

model DappConnectionRequest {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String                      @map("user_id") @db.Uuid
  origin               String
  name                 String
  iconUrl              String?                     @map("icon_url")
  requestedNetworks    Json                        @map("requested_networks")
  requestedPermissions Json                        @map("requested_permissions")
  status               DappConnectionRequestStatus @default(PENDING)
  proposalNonce        String                      @unique @map("proposal_nonce")
  sessionId            String?                     @map("session_id") @db.Uuid
  expiresAt            DateTime                    @map("expires_at")
  decidedAt            DateTime?                   @map("decided_at")
  metadata             Json?
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([origin, status])
  @@index([expiresAt])
  @@map("dapp_connection_requests")
}

model DappPermissionGrant {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  origin        String
  sessionId     String?            @map("session_id") @db.Uuid
  trustedDappId String?            @map("trusted_dapp_id") @db.Uuid
  permission    DappPermissionCode
  allowed       Boolean            @default(true)
  expiresAt     DateTime?          @map("expires_at")
  revokedAt     DateTime?          @map("revoked_at")
  metadata      Json?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([userId, origin, permission])
  @@index([userId, origin])
  @@index([sessionId])
  @@map("dapp_permission_grants")
}

model DappBrowserBookmark {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  url           String
  title         String
  origin        String
  faviconUrl    String?   @map("favicon_url")
  lastVisitedAt DateTime? @map("last_visited_at")
  visitCount    Int       @default(0) @map("visit_count")
  isTrusted     Boolean   @default(false) @map("is_trusted")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, url])
  @@index([userId, lastVisitedAt])
  @@map("dapp_browser_bookmarks")
}

model DappActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  origin    String?
  sessionId String?  @map("session_id") @db.Uuid
  eventType String   @map("event_type")
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([origin, createdAt])
  @@map("dapp_activity_events")
}
