enum KycSubjectType {
  INDIVIDUAL
  BUSINESS
}

enum KycLevel {
  NONE
  BASIC
  STANDARD
  ENHANCED
  FULL
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  PENDING_PROVIDER
  APPROVED
  REJECTED
  EXPIRED
  RENEWAL_REQUIRED
  CANCELLED
}

enum DocumentType {
  PASSPORT
  DRIVER_LICENSE
  NATIONAL_ID
  PROOF_OF_ADDRESS
  SELFIE
  LIVENESS
  INCORPORATION
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlAlertStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  CLOSED_FALSE_POSITIVE
  CLOSED_CONFIRMED
  SUPPRESSED
}

enum CaseStatus {
  OPEN
  ASSIGNED
  INVESTIGATING
  ESCALATED
  PENDING_EXTERNAL
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScreeningMatchStatus {
  CLEAR
  POTENTIAL
  CONFIRMED
  FALSE_POSITIVE
  PENDING
}

enum ComplianceRuleAction {
  ALLOW
  FLAG
  HOLD
  BLOCK
  REQUIRE_REVIEW
  OPEN_CASE
}

enum ComplianceProviderType {
  IDENTITY
  DOCUMENT
  SANCTIONS
  PEP
  ADDRESS_RISK
  BLOCKCHAIN_ANALYTICS
  FRAUD
  RISK_SCORING
  TRAVEL_RULE
}

model ComplianceProviderRecord {
  id           String                 @id @default(uuid()) @db.Uuid
  code         String                 @unique
  name         String
  providerType ComplianceProviderType @map("provider_type")
  isPrimary    Boolean                @default(false) @map("is_primary")
  isEnabled    Boolean                @default(true) @map("is_enabled")
  priority     Int                    @default(100)
  capabilities Json?
  endpointUrl  String?                @map("endpoint_url")
  metadata     Json?
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  health ComplianceProviderHealthSnapshot[]

  @@index([providerType, isEnabled, priority])
  @@map("compliance_providers")
}

model ComplianceProviderHealthSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String?  @map("provider_id") @db.Uuid
  providerCode String   @map("provider_code")
  status       String
  latencyMs    Int?     @map("latency_ms")
  errorMessage String?  @map("error_message")
  checkedAt    DateTime @default(now()) @map("checked_at")

  provider ComplianceProviderRecord? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([providerCode, checkedAt])
  @@map("compliance_provider_health_snapshots")
}

model KycProfile {
  id                    String             @id @default(uuid()) @db.Uuid
  ownerUserId           String             @unique @map("owner_user_id") @db.Uuid
  subjectType           KycSubjectType     @default(INDIVIDUAL) @map("subject_type")
  level                 KycLevel           @default(NONE)
  status                VerificationStatus @default(DRAFT)
  country               String?
  nationality           String?
  legalNameEncrypted    String?            @map("legal_name_encrypted")
  dateOfBirthEncrypted  String?            @map("date_of_birth_encrypted")
  businessNameEncrypted String?            @map("business_name_encrypted")
  riskBand              RiskBand           @default(LOW) @map("risk_band")
  riskScore             Decimal            @default(0) @map("risk_score") @db.Decimal(10, 4)
  verifiedAt            DateTime?          @map("verified_at")
  expiresAt             DateTime?          @map("expires_at")
  lastScreenedAt        DateTime?          @map("last_screened_at")
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  verificationRequests VerificationRequest[]
  documents            ComplianceDocument[]
  riskScores           RiskScoreRecord[]
  sanctionsResults     SanctionsScreeningResult[]
  pepResults           PepScreeningResult[]
  travelRuleRecords    TravelRuleRecord[]

  @@index([status, level])
  @@index([riskBand, updatedAt])
  @@map("kyc_profiles")
}

model VerificationRequest {
  id              String             @id @default(uuid()) @db.Uuid
  profileId       String             @map("profile_id") @db.Uuid
  ownerUserId     String             @map("owner_user_id") @db.Uuid
  requestedLevel  KycLevel           @map("requested_level")
  status          VerificationStatus @default(SUBMITTED)
  providerCode    String?            @map("provider_code")
  providerRef     String?            @map("provider_ref")
  rejectionReason String?            @map("rejection_reason")
  reviewerUserId  String?            @map("reviewer_user_id") @db.Uuid
  submittedAt     DateTime           @default(now()) @map("submitted_at")
  reviewedAt      DateTime?          @map("reviewed_at")
  completedAt     DateTime?          @map("completed_at")
  expiresAt       DateTime?          @map("expires_at")
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  profile   KycProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  documents ComplianceDocument[]

  @@index([ownerUserId, status, createdAt])
  @@index([status, submittedAt])
  @@index([profileId, createdAt])
  @@map("verification_requests")
}

model ComplianceDocument {
  id                    String         @id @default(uuid()) @db.Uuid
  profileId             String         @map("profile_id") @db.Uuid
  verificationRequestId String?        @map("verification_request_id") @db.Uuid
  ownerUserId           String         @map("owner_user_id") @db.Uuid
  documentType          DocumentType   @map("document_type")
  status                DocumentStatus @default(UPLOADED)
  storageKeyEncrypted   String         @map("storage_key_encrypted")
  contentType           String?        @map("content_type")
  fileName              String?        @map("file_name")
  checksumSha256        String?        @map("checksum_sha256")
  providerRef           String?        @map("provider_ref")
  rejectionReason       String?        @map("rejection_reason")
  verifiedAt            DateTime?      @map("verified_at")
  expiresAt             DateTime?      @map("expires_at")
  metadata              Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  profile             KycProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, documentType])
  @@index([verificationRequestId])
  @@index([status, createdAt])
  @@map("compliance_documents")
}

model RiskScoreRecord {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String?  @map("profile_id") @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  score         Decimal  @db.Decimal(10, 4)
  band          RiskBand
  factors       Json
  providerCode  String?  @map("provider_code")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  profile KycProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([band, createdAt])
  @@map("risk_score_records")
}

model AmlAlert {
  id          String           @id @default(uuid()) @db.Uuid
  ownerUserId String?          @map("owner_user_id") @db.Uuid
  paymentId   String?          @map("payment_id") @db.Uuid
  walletId    String?          @map("wallet_id") @db.Uuid
  ruleCode    String           @map("rule_code")
  severity    AmlAlertSeverity
  status      AmlAlertStatus   @default(OPEN)
  title       String
  description String?
  amount      Decimal?         @db.Decimal(36, 18)
  currency    String?
  evidence    Json?
  caseId      String?          @map("case_id") @db.Uuid
  resolvedAt  DateTime?        @map("resolved_at")
  resolvedBy  String?          @map("resolved_by") @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  case ComplianceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([ruleCode, createdAt])
  @@index([paymentId])
  @@map("aml_alerts")
}

model ComplianceCase {
  id               String       @id @default(uuid()) @db.Uuid
  reference        String       @unique
  ownerUserId      String?      @map("owner_user_id") @db.Uuid
  title            String
  description      String?
  status           CaseStatus   @default(OPEN)
  priority         CasePriority @default(MEDIUM)
  assignedToUserId String?      @map("assigned_to_user_id") @db.Uuid
  openedByUserId   String?      @map("opened_by_user_id") @db.Uuid
  resolution       String?
  resolvedAt       DateTime?    @map("resolved_at")
  closedAt         DateTime?    @map("closed_at")
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  alerts      AmlAlert[]
  notes       ComplianceCaseNote[]
  attachments ComplianceCaseAttachment[]
  auditTrail  ComplianceCaseAudit[]

  @@index([status, priority, createdAt])
  @@index([assignedToUserId, status])
