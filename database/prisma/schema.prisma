// ─── Phase 8: Notifications / Messaging ──────────────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  BROWSER
  WEBHOOK
  SLACK
  TEAMS
}

enum NotificationCategory {
  AUTH
  SECURITY
  KYC
  COMPLIANCE
  PAYMENT
  DEPOSIT
  WITHDRAWAL
  TRANSACTION
  WALLET
  CUSTODY
  RISK
  SYSTEM
  MARKETING
  ADMIN
  MARKET
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  QUEUED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  FAILED
  DEAD_LETTER
  CANCELLED
  SUPPRESSED
}

enum TemplateFormat {
  HTML
  TEXT
  MARKDOWN
  RICH
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  DEAD_LETTER
}

model NotificationChannelProvider {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique
  name            String
  channel         NotificationChannel
  isEnabled       Boolean             @default(true) @map("is_enabled")
  priority        Int                 @default(100)
  configEncrypted String?             @map("config_encrypted")
  healthStatus    String              @default("UNKNOWN") @map("health_status")
  lastCheckedAt   DateTime?           @map("last_checked_at")
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([channel, isEnabled])
  @@index([isEnabled, priority])
  @@map("notification_channel_providers")
}

model NotificationTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  code           String
