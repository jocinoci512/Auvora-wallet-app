// ─── Phase 7: Custody / Key Management / Signing ─────────────────────────────

enum CustodyModel {
  SELF
  HOSTED
  SHARED
  INSTITUTIONAL
  MPC
  HSM
}

enum KeyAlgorithm {
  SECP256K1
  ED25519
  BITCOIN_SECP256K1
  ETHEREUM_SECP256K1
  FUTURE_PQ
}

enum KeyStatus {
  PENDING
  ACTIVE
  ROTATING
  REVOKED
  DESTROYED
  RECOVERING
}

enum SigningRequestStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  QUEUED
  SCHEDULED
  SIGNING
  SIGNED
  FAILED
  CANCELLED
  EXPIRED
}

enum SigningRequestType {
  TRANSACTION
  MESSAGE
  BATCH
  OFFLINE
}

enum ApprovalPolicyKind {
  SINGLE
  DUAL
  MULTI
  THRESHOLD
  RISK_BASED
  AMOUNT_BASED
  ROLE_BASED
  EMERGENCY
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RecoveryRequestStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CustodyPolicyAction {
  ALLOW
  DENY
  REQUIRE_APPROVAL
  DELAY
  ALERT
}

model CustodyProviderRecord {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  custodyModel  CustodyModel @map("custody_model")
  isEnabled     Boolean      @default(true) @map("is_enabled")
  priority      Int          @default(100)
  config        Json?
  healthStatus  String       @default("UNKNOWN") @map("health_status")
  lastCheckedAt DateTime?    @map("last_checked_at")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  keys CryptographicKey[]

  @@index([isEnabled, priority])
  @@index([custodyModel])
  @@map("custody_providers")
}

model CryptographicKey {
  id                String       @id @default(uuid()) @db.Uuid
  ownerUserId       String       @map("owner_user_id") @db.Uuid
  walletId          String?      @map("wallet_id") @db.Uuid
  providerId        String?      @map("provider_id") @db.Uuid
  label             String?
  algorithm         KeyAlgorithm
  custodyModel      CustodyModel @map("custody_model")
  status            KeyStatus    @default(PENDING)
  publicKey         String       @map("public_key")
  /// Encrypted private key material or provider handle — never returned via API.
  materialEncrypted String?      @map("material_encrypted")
  providerRef       String?      @map("provider_ref")
  currentVersion    Int          @default(1) @map("current_version")
  exportAllowed     Boolean      @default(false) @map("export_allowed")
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  revokedAt         DateTime?    @map("revoked_at")
  destroyedAt       DateTime?    @map("destroyed_at")

  provider         CustodyProviderRecord? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  versions         KeyVersion[]
  auditLogs        KeyAuditLog[]
  signingRequests  SigningRequest[]
  recoveryRequests RecoveryRequest[]

  @@index([ownerUserId, status])
  @@index([walletId])
  @@index([providerId])
  @@index([status, createdAt])
  @@map("cryptographic_keys")
}

model KeyVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  keyId              String   @map("key_id") @db.Uuid
  version            Int
  publicKey          String   @map("public_key")
  materialEncrypted  String?  @map("material_encrypted")
  providerRef        String?  @map("provider_ref")
  createdAt          DateTime @default(now()) @map("created_at")
  rotatedFromVersion Int?     @map("rotated_from_version")

  key CryptographicKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, version])
  @@index([keyId, createdAt])
  @@map("key_versions")
}

model KeyAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  keyId       String?  @map("key_id") @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  details     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  key CryptographicKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("key_audit_logs")
}

