  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([isEnabled, priority])
  @@map("custody_transaction_policies")
}

model SigningRequest {
  id                String               @id @default(uuid()) @db.Uuid
  keyId             String               @map("key_id") @db.Uuid
  ownerUserId       String               @map("owner_user_id") @db.Uuid
  requestType       SigningRequestType   @map("request_type")
  status            SigningRequestStatus @default(PENDING)
  payloadHash       String               @map("payload_hash")
  payloadEncrypted  String?              @map("payload_encrypted")
  amount            String?
  asset             String?
  destination       String?
  riskScore         Int?                 @map("risk_score")
  approvalPolicyId  String?              @map("approval_policy_id") @db.Uuid
  requiredApprovals Int                  @default(0) @map("required_approvals")
  receivedApprovals Int                  @default(0) @map("received_approvals")
  scheduledAt       DateTime?            @map("scheduled_at")
  delayUntil        DateTime?            @map("delay_until")
  signature         String?
  signatureAlg      String?              @map("signature_alg")
  failureReason     String?              @map("failure_reason")
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  completedAt       DateTime?            @map("completed_at")

  key            CryptographicKey  @relation(fields: [keyId], references: [id], onDelete: Restrict)
  approvalPolicy ApprovalPolicy?   @relation(fields: [approvalPolicyId], references: [id], onDelete: SetNull)
  sessions       SigningSession[]
  approvals      ApprovalRequest[]

  @@index([ownerUserId, status])
  @@index([keyId, createdAt])
  @@index([status, createdAt])
  @@index([scheduledAt])
  @@map("signing_requests")
}

model SigningSession {
  id               String    @id @default(uuid()) @db.Uuid
  signingRequestId String    @map("signing_request_id") @db.Uuid
  providerCode     String?   @map("provider_code")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  latencyMs        Int?      @map("latency_ms")
  success          Boolean   @default(false)
  errorMessage     String?   @map("error_message")
  metadata         Json?

  request SigningRequest @relation(fields: [signingRequestId], references: [id], onDelete: Cascade)

  @@index([signingRequestId])
  @@index([startedAt])
  @@map("signing_sessions")
}

model ApprovalRequest {
  id               String                @id @default(uuid()) @db.Uuid
  signingRequestId String                @map("signing_request_id") @db.Uuid
  policyId         String?               @map("policy_id") @db.Uuid
  approverUserId   String?               @map("approver_user_id") @db.Uuid
  status           ApprovalRequestStatus @default(PENDING)
