  reason         String?
  approvalsCount Int                   @default(0) @map("approvals_count")
  expiresAt      DateTime?             @map("expires_at")
  completedAt    DateTime?             @map("completed_at")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  policy RecoveryPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  key    CryptographicKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, status])
  @@index([status, createdAt])
  @@map("recovery_requests")
}

model TransactionPolicy {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  name        String
  description String?
  isEnabled   Boolean             @default(true) @map("is_enabled")
  priority    Int                 @default(100)
