{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@auvora/config/*": ["packages/config/*"],
      "@auvora/types": ["packages/types/src/index.ts"],
      "@auvora/types/*": ["packages/types/src/*"],
      "@auvora/ui": ["packages/ui/src/index.ts"],
      "@auvora/ui/*": ["packages/ui/src/*"],
      "@auvora/security": ["packages/security/src/index.ts"],
      "@auvora/security/*": ["packages/security/src/*"],
      "@auvora/sdk": ["packages/sdk/src/index.ts"],
      "@auvora/sdk/*": ["packages/sdk/src/*"],
      "@auvora/database": ["packages/database/src/index.ts"],
      "@auvora/database/*": ["packages/database/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
