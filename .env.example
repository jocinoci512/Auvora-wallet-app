# Application
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://auvora:auvora@localhost:5432/auvora_wallet?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=auvora-wallet

# Service ports (Phase 2)
PORT=4000
GATEWAY_PORT=4000
AUTH_PORT=4001
AUTH_SERVICE_URL=http://127.0.0.1:4001
WALLET_SERVICE_URL=http://127.0.0.1:3002
WALLET_PORT=3002
BLOCKCHAIN_PORT=3003
PAYMENTS_PORT=3004
COMPLIANCE_PORT=3005
NOTIFICATIONS_PORT=3006
ANALYTICS_PORT=3007
AI_PORT=3008

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Auvora Wallet
APP_PUBLIC_URL=http://localhost:4000

# JWT (replace in any shared/non-local environment)
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-64-access-secret
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Cookies & CSRF
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CSRF_SECRET=change-me-generate-with-openssl-rand-base64-32-csrf-secret!!

# Account lockout & rate limits
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# Mail
MAIL_DRIVER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dev-mail-user
SMTP_PASS=change-me-mail-password
SMTP_FROM=noreply@auvora.local

# Seed admin (development only)
SEED_ADMIN_EMAIL=admin@auvora.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Dev-Only-123!
