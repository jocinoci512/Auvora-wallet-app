# =============================================================================
# Auvora Wallet â€” complete environment template
# Copy to `.env` for local use. Never commit real secrets.
# Staging / production: use secrets manager, Vercel env UI, or External Secrets.
# Generate secrets:  openssl rand -hex 32  |  openssl rand -base64 48
# Related: .env.staging.example Â· .env.production.example Â· DEPLOYMENT.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=auvora-wallet

# -----------------------------------------------------------------------------
# Data plane
# -----------------------------------------------------------------------------
# Prefer pooling in shared/staging/prod:
# ?schema=public&connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://auvora:auvora@localhost:5432/auvora_wallet?schema=public
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=auvora-wallet

# -----------------------------------------------------------------------------
# Gateway / edge
# -----------------------------------------------------------------------------
PORT=4000
GATEWAY_PORT=4000
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_MS=30000
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

# -----------------------------------------------------------------------------
# Service URLs (local defaults â€” override in K8s / cloud)
# -----------------------------------------------------------------------------
# Auth service listens on AUTH_PORT (auth loadEnv prefers AUTH_PORT over root PORT).
AUTH_PORT=4001
AUTH_SERVICE_URL=http://127.0.0.1:4001
WALLET_PORT=3002
WALLET_SERVICE_URL=http://127.0.0.1:3002
BLOCKCHAIN_PORT=3003
BLOCKCHAIN_SERVICE_URL=http://127.0.0.1:3003
PAYMENTS_PORT=3004
PAYMENTS_SERVICE_URL=http://127.0.0.1:3004
COMPLIANCE_PORT=3005
COMPLIANCE_SERVICE_URL=http://127.0.0.1:3005
NOTIFICATIONS_PORT=3006
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3006
ANALYTICS_PORT=3007
ANALYTICS_SERVICE_URL=http://127.0.0.1:3007
AI_PORT=3008
AI_SERVICE_URL=http://127.0.0.1:3008
CUSTODY_PORT=3009
CUSTODY_SERVICE_URL=http://127.0.0.1:3009
OBSERVABILITY_PORT=3010
OBSERVABILITY_SERVICE_URL=http://127.0.0.1:3010
MARKET_DATA_PORT=3012
MARKET_DATA_SERVICE_URL=http://127.0.0.1:3012
SWAP_PORT=3013
SWAP_SERVICE_URL=http://127.0.0.1:3013
NFT_PORT=3014
NFT_SERVICE_URL=http://127.0.0.1:3014
STAKING_PORT=3015
STAKING_SERVICE_URL=http://127.0.0.1:3015
CONNECTIONS_PORT=3016
CONNECTIONS_SERVICE_URL=http://127.0.0.1:3016
BRIDGE_PORT=3017
BRIDGE_SERVICE_URL=http://127.0.0.1:3017

# -----------------------------------------------------------------------------
# Blockchain / Alchemy
# -----------------------------------------------------------------------------
BLOCKCHAIN_SIMULATOR_ENABLED=false
BLOCKCHAIN_PRIMARY_PROVIDER=alchemy
BLOCKCHAIN_SYNC_INTERVAL_MS=5000
BLOCKCHAIN_HTTP_TIMEOUT_MS=12000
ALCHEMY_API_KEY=
ALCHEMY_ETHEREUM_RPC_URL=
ALCHEMY_POLYGON_RPC_URL=
ALCHEMY_BSC_RPC_URL=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_TRON_RPC_URL=
ALCHEMY_BITCOIN_RPC_URL=
ALCHEMY_RPC_TIMEOUT_MS=12000
# ALCHEMY_REQUIRED=true

# -----------------------------------------------------------------------------
# WalletConnect / Reown (https://cloud.reown.com)
# Project ID only — never put a Reown Secret here.
# Mobile: Flutter --dart-define=WC_PROJECT_ID=... (not auto-loaded from this file).
# Web: NEXT_PUBLIC_WC_PROJECT_ID is the same public Project ID (never a Reown Secret).
# See also apps/mobile/.env.example
# -----------------------------------------------------------------------------
WC_PROJECT_ID=
NEXT_PUBLIC_WC_PROJECT_ID=

# -----------------------------------------------------------------------------
# Wallet workers
# -----------------------------------------------------------------------------
WALLET_WORKERS_ENABLED=true
WALLET_SYNC_INTERVAL_MS=30000
WALLET_BALANCE_INTERVAL_MS=45000
WALLET_PORTFOLIO_INTERVAL_MS=60000
WALLET_RETRY_INTERVAL_MS=20000
WALLET_HEALTH_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Domain services â€” simulators & workers
# -----------------------------------------------------------------------------
PAYMENTS_SIMULATOR_ENABLED=false
COMPLIANCE_SIMULATOR_ENABLED=false
COMPLIANCE_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
CUSTODY_SIMULATOR_ENABLED=false
CUSTODY_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
NOTIFICATIONS_SIMULATOR_ENABLED=false
NOTIFICATIONS_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
NOTIFICATIONS_QUEUE_POLL_INTERVAL_MS=2000
NOTIFICATIONS_QUEUE_WORKER_ENABLED=true
NOTIFICATIONS_WEBHOOK_WORKER_ENABLED=true
NOTIFICATIONS_CHANNEL_EMAIL_ENABLED=true
NOTIFICATIONS_CHANNEL_SMS_ENABLED=true
NOTIFICATIONS_CHANNEL_PUSH_ENABLED=true
NOTIFICATIONS_CHANNEL_IN_APP_ENABLED=true
NOTIFICATIONS_CHANNEL_BROWSER_ENABLED=true
NOTIFICATIONS_CHANNEL_WEBHOOK_ENABLED=true
NOTIFICATIONS_CHANNEL_SLACK_ENABLED=true
NOTIFICATIONS_CHANNEL_TEAMS_ENABLED=true
# NOTIFICATIONS_EMAIL_PROVIDER_URL=
# NOTIFICATIONS_EMAIL_PROVIDER_TOKEN=
ANALYTICS_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
OBSERVABILITY_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
AI_SIMULATOR_ENABLED=true
AI_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
# AI_OPENAI_API_KEY=
# AI_ANTHROPIC_API_KEY=
MARKET_DATA_SIMULATOR_ENABLED=true
MARKET_DATA_WORKERS_ENABLED=true
MARKET_DATA_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
# COINGECKO_API_KEY=
SWAP_SIMULATOR_ENABLED=true
SWAP_WORKERS_ENABLED=true
SWAP_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
NFT_SIMULATOR_ENABLED=true
NFT_WORKERS_ENABLED=true
NFT_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
STAKING_SIMULATOR_ENABLED=true
STAKING_WORKERS_ENABLED=true
STAKING_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
CONNECTIONS_SIMULATOR_ENABLED=true
CONNECTIONS_WORKERS_ENABLED=true
CONNECTIONS_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
BRIDGE_SIMULATOR_ENABLED=true
BRIDGE_WORKERS_ENABLED=true
BRIDGE_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# -----------------------------------------------------------------------------
# Auth / cookies / CSRF
# -----------------------------------------------------------------------------
# Generate local secrets (never commit): openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-64-access-secret
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
# Prefer host-only cookies (leave empty). Auth cookies are set by the API host.
# Do NOT set "localhost" — browsers drop Domain=localhost.
# Only set e.g. .auvorawallet.com if you deliberately need cross-subdomain cookie sharing.
COOKIE_DOMAIN=
CSRF_SECRET=<generate-with-openssl-rand-base64-32>
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Local options:
#   (a) MAIL_DRIVER=console — verification links print in auth logs (tokens redacted)
#   (b) Mailpit: docker compose --profile mail up -d
#       MAIL_DRIVER=smtp SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_FROM=noreply@auvora.local
#       Inbox UI: http://127.0.0.1:8025
# Prod: MAIL_DRIVER=smtp with a transactional SMTP provider (recommended: Resend SMTP).
#       Do NOT use console in production (startup validation fails).
# Optional: MAIL_DRIVER=notifications + NOTIFICATIONS_SERVICE_URL + INTERNAL_API_KEY
MAIL_DRIVER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@auvora.local
SMTP_FROM_NAME=Auvora Wallet
MAIL_RATE_LIMIT_MAX=5
MAIL_RATE_LIMIT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Object storage / CDN
# -----------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
CDN_ASSET_BASE_URL=
NEXT_PUBLIC_CDN_ASSET_BASE_URL=

# -----------------------------------------------------------------------------
# Frontends (Next.js / Vercel — NEXT_PUBLIC_* baked at build time)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Auvora Wallet
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_DOCS_URL=http://localhost:3011
NEXT_PUBLIC_STATUS_URL=http://localhost:3000/status
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# MUST be the browser web origin (verify/reset links), NOT the API gateway.
# Local: http://localhost:3000
# Prod canonical: https://auvorawallet.com  (www redirects → apex at Vercel; see apps/web/vercel.json)
APP_PUBLIC_URL=http://localhost:3000
# Non-production only — must be false in production (enforced by auth env schema).
AUTH_ALLOW_UNVERIFIED_LOGIN=false
# Credentialed CORS allowlist (gateway + auth). Never `*`. Localhost for local only.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3011

# -----------------------------------------------------------------------------
# Seed (local / staging only â€” never production defaults)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@auvora.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Dev-Only-123!

# -----------------------------------------------------------------------------
# Production overrides (reference only — set in Vercel / secrets manager / Helm)
# Do NOT put production secrets in this file. Origin strings below are non-secret.
# WWW→apex redirect: hosting (apps/web/vercel.json). Keep www in CORS until DNS settles.
# Reown Cloud: add https://auvorawallet.com on the existing project (keep www if already listed).
# -----------------------------------------------------------------------------
# NODE_ENV=production
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# APP_PUBLIC_URL=https://auvorawallet.com
# NEXT_PUBLIC_APP_URL=https://auvorawallet.com
# NEXT_PUBLIC_MARKETING_URL=https://auvorawallet.com
# NEXT_PUBLIC_STATUS_URL=https://auvorawallet.com/status
# NEXT_PUBLIC_API_URL=https://api.auvorawallet.com
# CORS_ORIGINS=https://auvorawallet.com,https://www.auvorawallet.com
# BLOCKCHAIN_SIMULATOR_ENABLED=false
# OTEL_ENABLED=true
