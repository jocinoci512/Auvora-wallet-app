# Application
NODE_ENV=development
LOG_LEVEL=info

# Database
# Prefer connection pooling in production (PgBouncer or Prisma params):
# DATABASE_URL=postgresql://auvora:auvora@localhost:5432/auvora_wallet?schema=public&connection_limit=10&pool_timeout=10
DATABASE_URL=postgresql://auvora:auvora@localhost:5432/auvora_wallet?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Gateway edge controls (Phase 13)
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_MS=30000

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=auvora-wallet

# Service ports (Phase 2)
PORT=4000
GATEWAY_PORT=4000
AUTH_PORT=4001
AUTH_SERVICE_URL=http://127.0.0.1:4001
WALLET_SERVICE_URL=http://127.0.0.1:3002
WALLET_PORT=3002
BLOCKCHAIN_SERVICE_URL=http://127.0.0.1:3003
BLOCKCHAIN_PORT=3003
PAYMENTS_SERVICE_URL=http://127.0.0.1:3004
PAYMENTS_PORT=3004
PAYMENTS_SIMULATOR_ENABLED=false
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>
COMPLIANCE_PORT=3005
COMPLIANCE_SERVICE_URL=http://127.0.0.1:3005
COMPLIANCE_SIMULATOR_ENABLED=false
COMPLIANCE_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
CUSTODY_PORT=3009
CUSTODY_SERVICE_URL=http://127.0.0.1:3009
CUSTODY_SIMULATOR_ENABLED=false
CUSTODY_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
NOTIFICATIONS_PORT=3006
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3006
NOTIFICATIONS_SIMULATOR_ENABLED=false
NOTIFICATIONS_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
NOTIFICATIONS_QUEUE_POLL_INTERVAL_MS=2000
NOTIFICATIONS_QUEUE_WORKER_ENABLED=true
NOTIFICATIONS_WEBHOOK_WORKER_ENABLED=true

# Per-channel kill switches (default true). Set to false to hard-disable a channel
# without a deploy, regardless of the DB-backed notification_channel_providers rows.
NOTIFICATIONS_CHANNEL_EMAIL_ENABLED=true
NOTIFICATIONS_CHANNEL_SMS_ENABLED=true
NOTIFICATIONS_CHANNEL_PUSH_ENABLED=true
NOTIFICATIONS_CHANNEL_IN_APP_ENABLED=true
NOTIFICATIONS_CHANNEL_BROWSER_ENABLED=true
NOTIFICATIONS_CHANNEL_WEBHOOK_ENABLED=true
NOTIFICATIONS_CHANNEL_SLACK_ENABLED=true
NOTIFICATIONS_CHANNEL_TEAMS_ENABLED=true

# Real backend HTTP providers (only used when NOTIFICATIONS_SIMULATOR_ENABLED=false).
# Leave unset to fall back to a local no-op (IN_APP/BROWSER/WEBHOOK) or an
# UnavailableChannelProvider (EMAIL/SMS/PUSH/SLACK/TEAMS).
# NOTIFICATIONS_EMAIL_PROVIDER_URL=https://provider.example.com/send-email
# NOTIFICATIONS_EMAIL_PROVIDER_TOKEN=<provider-bearer-token>
# NOTIFICATIONS_SMS_PROVIDER_URL=https://provider.example.com/send-sms
# NOTIFICATIONS_SMS_PROVIDER_TOKEN=<provider-bearer-token>
# NOTIFICATIONS_PUSH_PROVIDER_URL=https://provider.example.com/send-push
# NOTIFICATIONS_PUSH_PROVIDER_TOKEN=<provider-bearer-token>
# NOTIFICATIONS_SLACK_PROVIDER_URL=https://hooks.slack.com/services/...
# NOTIFICATIONS_SLACK_PROVIDER_TOKEN=<provider-bearer-token>
# NOTIFICATIONS_TEAMS_PROVIDER_URL=https://provider.example.com/send-teams
# NOTIFICATIONS_TEAMS_PROVIDER_TOKEN=<provider-bearer-token>
ANALYTICS_PORT=3007
ANALYTICS_SERVICE_URL=http://127.0.0.1:3007
ANALYTICS_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

OBSERVABILITY_PORT=3010
OBSERVABILITY_SERVICE_URL=http://127.0.0.1:3010
OBSERVABILITY_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
AI_PORT=3008
AI_SERVICE_URL=http://127.0.0.1:3008
AI_SIMULATOR_ENABLED=true
AI_FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
# Optional real provider keys (only used when AI_SIMULATOR_ENABLED=false)
# AI_OPENAI_API_KEY=<provider-api-key>
# AI_ANTHROPIC_API_KEY=<provider-api-key>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Auvora Wallet
APP_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT (replace in any shared/non-local environment)
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-64-access-secret
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Cookies & CSRF
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CSRF_SECRET=change-me-generate-with-openssl-rand-base64-32-csrf-secret!!

# Account lockout & rate limits
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# Mail
MAIL_DRIVER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dev-mail-user
SMTP_PASS=change-me-mail-password
SMTP_FROM=noreply@auvora.local

# Seed admin (development only)
SEED_ADMIN_EMAIL=admin@auvora.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Dev-Only-123!
