{
  "name": "@auvora/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "generate": "node ../../scripts/ensure-prisma-client.mjs",
    "migrate:dev": "pnpm --filter @auvora/database-schema migrate:dev",
    "migrate:deploy": "pnpm --filter @auvora/database-schema migrate:deploy",
    "seed": "pnpm --filter @auvora/database-schema seed",
    "lint": "eslint .",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@auvora/database-schema": "workspace:*",
    "@nestjs/common": "^11.0.12"
  },
  "devDependencies": {
    "@auvora/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
